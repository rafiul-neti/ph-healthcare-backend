                  "
                >
                  With PH Healthcare, you can find and consult with
                  doctors you prefer, receive prescriptions, and manage
                  your healthcare experience in one place.
                </p>

                <!-- What you can do -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    background-color: #f0fdfa;
                    border-radius: 8px;
                    margin-bottom: 24px;
                  "
                >
                  <tr>
                    <td style="padding: 20px;">
                      <p
                        style="
                          margin: 0 0 12px;
                          color: #0f766e;
                          font-size: 15px;
                          font-weight: 700;
                        "
                      >
                        What you can do with PH Healthcare
                      </p>

                      <p
                        style="
                          margin: 0 0 8px;
                          color: #4b5563;
                          font-size: 14px;
                          line-height: 1.5;
                        "
                      >
                        • Find doctors that suit your needs
                      </p>

                      <p
                        style="
                          margin: 0 0 8px;
                          color: #4b5563;
                          font-size: 14px;
                          line-height: 1.5;
                        "
                      >
                        • Consult with your preferred doctors
                      </p>

                      <p
                        style="
                          margin: 0;
                          color: #4b5563;
                          font-size: 14px;
                          line-height: 1.5;
                        "
                      >
                        • Receive and manage your prescriptions
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #6b7280;
                  "
