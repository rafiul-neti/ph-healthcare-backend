<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Welcome to PH Healthcare</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f8fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="background-color: #f4f8fb; padding: 40px 16px;"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 520px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background-color: #0f766e;
                  padding: 32px;
                  text-align: center;
                "
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 28px;
                    font-weight: 700;
                  "
                >
                  PH Healthcare
                </h1>

                <p
                  style="
                    margin: 8px 0 0;
                    color: #d1fae5;
                    font-size: 14px;
                  "
                >
                  Your healthcare, made simpler.
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 36px 32px;">
                <div
                  style="
                    width: 64px;
                    height: 64px;
                    margin: 0 auto 20px;
                    background-color: #d1fae5;
                    border-radius: 50%;
                    text-align: center;
                    line-height: 64px;
                    color: #0f766e;
                    font-size: 30px;
                    font-weight: 700;
                  "
                >
                  ✓
                </div>

                <h2
                  style="
                    margin: 0 0 18px;
                    color: #111827;
                    font-size: 22px;
                    text-align: center;
                  "
                >
                  Welcome to PH Healthcare!
                </h2>

                <p
                  style="
                    margin: 0 0 16px;
                    font-size: 15px;
                    line-height: 1.6;
                  "
                >
                  Hi <%= name %>,
                </p>

                <p
                  style="
                    margin: 0 0 18px;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #4b5563;
                  "
                >
                  Welcome to PH Healthcare! Your account has been
                  successfully created, and we're happy to have you
                  with us.
                </p>

                <p
                  style="
                    margin: 0 0 24px;
                    font-size: 15px;
